          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <enable>false</enable>
          <control type="edit" format="string">
            <heading>30103</heading>
          </control>
        </setting>
        <setting id="subscription_expires" type="string" label="30104" help="">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <enable>false</enable>
          <control type="edit" format="string">
            <heading>30104</heading>
          </control>
        </setting>
        <setting id="max_devices" type="string" label="30105" help="">
          <level>0</level>
          <default/>
          <constraints>
