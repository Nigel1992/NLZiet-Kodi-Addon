          <level>1</level>
          <default>https://api.nlziet.nl</default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30109</heading>
          </control>
        </setting>
      </group>
    </category>

    <category id="category_playback" label="30006" help="">
      <group id="1" label="">
