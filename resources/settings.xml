          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <category id="category_sync" label="30008" help="">
      <group id="1" label="">
        <setting id="watch_later_sync" type="boolean" label="30114" help="30116">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="auto_add_new_episodes" type="boolean" label="33148" help="33155">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="sync_watch_later_now" type="action" label="30115" help="">
          <level>0</level>
          <data>RunPlugin(plugin://$ID?mode=sync_watch_later)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
        <setting id="sync_my_series_now" type="action" label="30117" help="">
          <level>0</level>
          <data>RunPlugin(plugin://$ID?mode=sync_my_series)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
      </group>
    </category>

    <category id="category_expiry" label="33153" help="">
      <group id="1" label="">
        <setting id="expiry_notify_enabled" type="boolean" label="33149" help="">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="expiry_notify_hours" type="integer" label="33150" help="">
          <level>0</level>
          <default>24</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>168</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="expiry_notify_watch_later" type="boolean" label="33151" help="">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="expiry_notify_my_series" type="boolean" label="33152" help="">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <category id="category_debug" label="30007" help="">
      <group id="1" label="">
        <setting id="debug_http" type="boolean" label="30111" help="">
          <level>2</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="export_diagnostics" type="action" label="30112" help="30113">
          <level>0</level>
          <data>RunPlugin(plugin://$ID?mode=export_diagnostics)</data>
          <control type="button" format="action">
            <close>false</close>
          </control>
        </setting>
      </group>
    </category>

    <category id="tv-integration" label="30130" help="">
      <group id="2" label="">
        <setting id="install_iptvmanager" label="30131" type="action" help="">
            <level>0</level>
            <data>InstallAddon(service.iptv.manager)</data>
            <control type="button" format="action">
                <close>true</close>
            </control>
            <dependencies>
                <dependency type="visible" on="property" name="infobool" operator="!is">System.HasAddon(service.iptv.manager)</dependency>
            </dependencies>
        </setting>
        <setting id="iptv.enabled" label="30132" type="boolean" help="30332">
            <level>0</level>
            <default>true</default>
            <control type="toggle"/>
            <dependencies>
                <dependency type="visible" on="property" name="infobool">System.HasAddon(service.iptv.manager)</dependency>
            </dependencies>
        </setting>
        <setting id="iptvmanager-settings" label="30133" type="action" help="" parent="iptv.enabled">
            <data>Addon.OpenSettings(service.iptv.manager)</data>
            <dependencies>
                <dependency type="enable" setting="iptv.enabled">true</dependency>
                <dependency type="visible" on="property" name="infobool">System.HasAddon(service.iptv.manager)</dependency>
            </dependencies>
            <control type="button" format="action">
                <close>true</close>
            </control>
        </setting>
        <setting id="iptv-select-channels" label="30134" type="action" help="30135" parent="iptv.enabled">
            <level>0</level>
            <data>RunPlugin(plugin://$ID/?mode=iptv-select-channels)</data>
            <dependencies>
                <dependency type="enable" setting="iptv.enabled">true</dependency>
            </dependencies>
            <control type="button" format="action">
                <close>false</close>
            </control>
        </setting>
        <setting id="iptv.channels_uri" label="" type="string" help="">
            <default>plugin://plugin.video.nlziet?mode=iptv-channels</default>
            <visible>false</visible>
            <control type="edit" format="string" />
        </setting>
        <setting id="iptv.epg_uri" label="" type="string" help="">
            <default>plugin://plugin.video.nlziet?mode=iptv.epg</default>
            <visible>false</visible>
            <control type="edit" format="string" />
        </setting>
        <setting id="library_path" label="30136" type="string" help="">
            <level>0</level>
            <default>/storage/emulated/0/KodiNLZietLibrary/TV Shows</default>
            <control type="edit" format="string">
                <heading>30136</heading>
            </control>
        </setting>
      </group>
    </category>

  </section>
</settings>
