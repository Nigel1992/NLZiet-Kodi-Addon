          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <enable>false</enable>
          <control type="edit" format="string">
            <heading>30107</heading>
          </control>
        </setting>
        <setting id="profile_name" type="string" label="30108" help="">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <enable>false</enable>
          <control type="edit" format="string">
            <heading>30108</heading>
